rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /students/{studentId}/diary/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == studentId;
    }

    match /students/{studentId} {
      allow read, write: if request.auth != null && request.auth.uid == studentId;
    }
  }
}
