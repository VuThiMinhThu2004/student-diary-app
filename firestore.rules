rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Quy tắc cho users collection
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Quy tắc cho courses collection
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null && 
        resource.data.teacherId == request.auth.uid;
    }
    
    // Quy tắc cho students collection (nhật ký cũ)
    match /students/{studentId}/diary/{logId} {
      allow read, write: if request.auth != null;
    }
    
    // Quy tắc cho students collection với courses subcollection (cấu trúc mới)
    match /students/{studentId}/courses/{courseId}/diary/{logId} {
      allow read, write: if request.auth != null;
    }
  }
}
